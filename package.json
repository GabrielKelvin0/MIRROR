{
  "name": "mirror",
  "version": "0.1.0",
  "description": "See how experienced investors think, across every market, before you invest your own money.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:routes": "node scripts/check-routes.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "next": "^15.0.0",
    "@clerk/nextjs": "^6.39.6",
    "@prisma/client": "^5.21.0",
    "server-only": "^0.0.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^22.12.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.27",
    "prettier": "^3.2.0",
    "prisma": "^5.21.0",
    "vitest": "^5.0.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.29"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "js-cookie": "3.0.8",
    "postcss": "$postcss",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.21"
    },
    "minimatch@10.2.6": {
      "brace-expansion": "5.0.12"
    }
  }
}
