# MIRROR Environment Configuration
# Copy to .env.local and fill in actual values.
#
# Classification:
#   Required for local/runtime  - needed to run the app locally or in a runtime environment
#   Required for Prisma CLI     - prisma validate/generate/migrate only need these DEFINED
#                                 (they are not connected to in static/CI checks)
#   Optional                    - safe to leave unset (library defaults apply)
#   Development-only            - never set in production/staging
#   Future (not consumed)       - documented providers the current code does not read

# ---------------------------------------------------------------------------
# Clerk Authentication
# ---------------------------------------------------------------------------
# Required for local/runtime. Public client key; safe to expose (it is NOT a secret).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Required for local/runtime. Server secret; never commit it, never prefix with
# NEXT_PUBLIC_, never expose it to the browser.
CLERK_SECRET_KEY=
# Optional. Clerk route orchestration; defaults to /sign-in and /sign-up when unset.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ---------------------------------------------------------------------------
# Database (Neon Postgres)
# ---------------------------------------------------------------------------
# Required for local/runtime. Pooled connection string used by the application.
DATABASE_URL="postgresql://user:password@localhost:5432/mirror_dev?schema=public"
# Required for Prisma CLI. Direct (unpooled) connection string used by
# Prisma Migrate; the schema reads it via env("DIRECT_URL").
DIRECT_URL="postgresql://user:password@localhost:5432/mirror_dev?schema=public"

# If the repository is linked to a Neon project, `neon env pull` writes
# DATABASE_URL (pooled), DATABASE_URL_UNPOOLED (direct) and NEON_BRANCH.
# Point DIRECT_URL at the unpooled value so Prisma Migrate bypasses the pooler.

# ---------------------------------------------------------------------------
# Optional future providers (documented only; NOT consumed by current code)
# ---------------------------------------------------------------------------
# MARKET_DATA_API_KEY=
# STRIPE_PUBLIC_KEY=
# STRIPE_SECRET_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Development-only
# ---------------------------------------------------------------------------
# NODE_ENV is managed by Next.js per command; do not set it manually.
